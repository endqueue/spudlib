// spudgpu_objects_test's mesh shader: one cell's quad per workgroup, from
// the cell in the push constants along x.
#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;

layout(push_constant) uniform Push {
	vec4 color;
	vec4 params;
} pc;

layout(location = 0) out vec2 uv[];

void main() {
	SetMeshOutputsEXT(4, 2);
	vec2 cell = pc.params.zw + vec2(float(gl_WorkGroupID.x), 0.0);
	for (int i = 0; i < 4; ++i) {
		vec2 c                             = vec2(float(i & 1), float(i >> 1));
		vec2 p                             = (cell + c) / 8.0;
		gl_MeshVerticesEXT[i].gl_Position = vec4(p * 2.0 - 1.0, pc.params.x, 1.0);
		uv[i]                              = c;
	}
	gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
	gl_PrimitiveTriangleIndicesEXT[1] = uvec3(2, 1, 3);
}
