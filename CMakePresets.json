{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-d3d12",
      "displayName": "SpudLib Windows D3D12",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows-d3d12",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "D3D12",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "windows-vulkan",
      "displayName": "SpudLib Windows Vulkan",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows-vulkan",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Vulkan",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "linux-vulkan",
      "displayName": "SpudLib Linux Vulkan",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-linux-vulkan",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Vulkan",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "macos-metal",
      "displayName": "SpudLib macOS Metal",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-macos-metal",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Metal",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "macos-metal-xcode",
      "displayName": "SpudLib macOS Metal (Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build-xcode-macos-metal",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Metal",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "iossimulator-metal",
      "displayName": "SpudLib iOS Metal (simulator)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-iossimulator-metal",
      "cacheVariables": {
        "GRAPHICS_BACKEND": "Metal",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.5",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_MACOSX_BUNDLE": "OFF",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "sanitize-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJC_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "sanitize-tsan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_OBJC_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "macos-metal-asan",
      "displayName": "SpudLib macOS ASan+UBSan",
      "inherits": ["sanitize-asan", "macos-metal"],
      "binaryDir": "${sourceDir}/build-macos-metal-asan"
    },
    {
      "name": "macos-metal-tsan",
      "displayName": "SpudLib macOS TSan",
      "inherits": ["sanitize-tsan", "macos-metal"],
      "binaryDir": "${sourceDir}/build-macos-metal-tsan"
    },
    {
      "name": "linux-vulkan-asan",
      "displayName": "SpudLib Linux ASan+UBSan",
      "inherits": ["sanitize-asan", "linux-vulkan"],
      "binaryDir": "${sourceDir}/build-linux-vulkan-asan"
    },
    {
      "name": "linux-vulkan-tsan",
      "displayName": "SpudLib Linux TSan",
      "inherits": ["sanitize-tsan", "linux-vulkan"],
      "binaryDir": "${sourceDir}/build-linux-vulkan-tsan"
    },
    {
      "name": "sanitize-fuzz",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "SPUDLIB_BUILD_FUZZERS": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJC_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_OBJCXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "macos-fuzz",
      "displayName": "SpudLib macOS libFuzzer (Homebrew LLVM)",
      "inherits": ["sanitize-fuzz", "macos-metal"],
      "binaryDir": "${sourceDir}/build-macos-fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_OBJC_COMPILER": "/opt/homebrew/opt/llvm/bin/clang"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "SpudLib Linux libFuzzer (clang)",
      "inherits": ["sanitize-fuzz", "linux-vulkan"],
      "binaryDir": "${sourceDir}/build-linux-fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-sanitize-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "/Ob0 /Od /fsanitize=address",
        "CMAKE_CXX_FLAGS_DEBUG": "/Ob0 /Od /fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO",
        "CMAKE_MODULE_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO"
      }
    },
    {
      "name": "windows-d3d12-asan",
      "displayName": "SpudLib Windows D3D12 ASan",
      "inherits": [
        "windows-sanitize-asan",
        "windows-d3d12"
      ],
      "binaryDir": "${sourceDir}/build-windows-d3d12-asan"
    },
    {
      "name": "windows-vulkan-asan",
      "displayName": "SpudLib Windows Vulkan ASan",
      "inherits": [
        "windows-sanitize-asan",
        "windows-vulkan"
      ],
      "binaryDir": "${sourceDir}/build-windows-vulkan-asan"
    },
    {
      "name": "windows-fuzz",
      "displayName": "SpudLib Windows libFuzzer (clang)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-windows-fuzz",
      "cacheVariables": {
        "SPUDLIB_BUILD_FUZZERS": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -fno-sanitize-coverage=indirect-calls,trace-cmp",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -fno-sanitize-coverage=indirect-calls,trace-cmp -D_DISABLE_STRING_ANNOTATION -D_DISABLE_VECTOR_ANNOTATION",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "GRAPHICS_BACKEND": "D3D12",
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
