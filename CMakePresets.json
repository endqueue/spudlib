      "configuration": "Release"
    },
    {
      "name": "windows-vulkan-relwithdebinfo",
      "displayName": "SpudLib Windows Vulkan (RelWithDebInfo)",
      "configurePreset": "windows-vulkan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-vulkan-debug",
      "displayName": "SpudLib Linux Vulkan (Debug)",
      "configurePreset": "linux-vulkan",
      "configuration": "Debug"
    },
    {
      "name": "linux-vulkan-release",
      "displayName": "SpudLib Linux Vulkan (Release)",
      "configurePreset": "linux-vulkan",
      "configuration": "Release"
    },
    {
      "name": "linux-vulkan-relwithdebinfo",
      "displayName": "SpudLib Linux Vulkan (RelWithDebInfo)",
      "configurePreset": "linux-vulkan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-metal-debug",
      "displayName": "SpudLib macOS Metal (Debug)",
      "configurePreset": "macos-metal",
      "configuration": "Debug"
    },
    {
      "name": "macos-metal-release",
      "displayName": "SpudLib macOS Metal (Release)",
      "configurePreset": "macos-metal",
      "configuration": "Release"
    },
    {
      "name": "macos-metal-relwithdebinfo",
      "displayName": "SpudLib macOS Metal (RelWithDebInfo)",
      "configurePreset": "macos-metal",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-metal-xcode-debug",
      "displayName": "SpudLib macOS Metal (Xcode) (Debug)",
      "configurePreset": "macos-metal-xcode",
      "configuration": "Debug"
    },
    {
      "name": "macos-metal-xcode-release",
      "displayName": "SpudLib macOS Metal (Xcode) (Release)",
      "configurePreset": "macos-metal-xcode",
      "configuration": "Release"
    },
    {
      "name": "macos-metal-xcode-relwithdebinfo",
      "displayName": "SpudLib macOS Metal (Xcode) (RelWithDebInfo)",
      "configurePreset": "macos-metal-xcode",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "iossimulator-metal-debug",
      "displayName": "SpudLib iOS Metal (simulator) (Debug)",
      "configurePreset": "iossimulator-metal",
      "configuration": "Debug"
    },
    {
      "name": "iossimulator-metal-release",
      "displayName": "SpudLib iOS Metal (simulator) (Release)",
