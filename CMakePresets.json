      "displayName": "SpudLib macOS ASan+UBSan (Debug)",
      "configurePreset": "macos-metal-asan",
      "configuration": "Debug"
    },
    {
      "name": "macos-metal-tsan-debug",
      "displayName": "SpudLib macOS TSan (Debug)",
      "configurePreset": "macos-metal-tsan",
      "configuration": "Debug"
    },
    {
      "name": "linux-vulkan-asan-debug",
      "displayName": "SpudLib Linux ASan+UBSan (Debug)",
      "configurePreset": "linux-vulkan-asan",
      "configuration": "Debug"
    },
    {
      "name": "linux-vulkan-tsan-debug",
      "displayName": "SpudLib Linux TSan (Debug)",
      "configurePreset": "linux-vulkan-tsan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "macos-metal-asan",
      "configurePreset": "macos-metal-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "macos-metal-tsan",
      "configurePreset": "macos-metal-tsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "linux-vulkan-asan",
      "configurePreset": "linux-vulkan-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_stack_use_after_return=1:check_initialization_order=1:strict_init_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "linux-vulkan-tsan",
      "configurePreset": "linux-vulkan-tsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ]
}
